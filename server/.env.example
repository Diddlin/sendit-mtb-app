# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/mtnbikeapp

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# TrailForks API
TRAILFORKS_APP_ID=your_trailforks_app_id
TRAILFORKS_APP_SECRET=your_trailforks_app_secret

# AllTrails API (requires partnership/developer access)
ALLTRAILS_API_KEY=your_alltrails_api_key

# Singletracks TrailAPI via RapidAPI (free tier available)
# Sign up at https://rapidapi.com/trailapi/api/trailapi
RAPIDAPI_KEY=your_rapidapi_key

# OpenStreetMap Overpass API — NO KEY NEEDED, works out of the box

# Garmin Connect OAuth
GARMIN_CONSUMER_KEY=your_garmin_consumer_key
GARMIN_CONSUMER_SECRET=your_garmin_consumer_secret
GARMIN_CALLBACK_URL=http://localhost:3000/auth/garmin/callback

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
